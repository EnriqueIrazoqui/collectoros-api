// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    Int       @id @default(autoincrement())
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  displayName           String    @map("display_name")
  refreshTokenHash      String?   @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  role                  String    @default("user")
  isActive              Boolean   @default(true) @map("is_active")

  microsoftAccountId      String?   @map("microsoft_account_id")
  microsoftAccessToken    String?   @map("microsoft_access_token")
  microsoftRefreshToken   String?   @map("microsoft_refresh_token")
  microsoftTokenExpiresAt DateTime? @map("microsoft_token_expires_at")

  hasSeenWelcome           Boolean   @default(false) @map("has_seen_welcome")
  welcomeSeenAt            DateTime? @map("welcome_seen_at")

  inventoryItems       InventoryItem[]
  wishlistItems        WishlistItem[]
  inventoryItemImages  InventoryItemImage[]
  wishlistAlerts       WishlistAlert[]

  @@map("users")
}

model InventoryItem {
  id                    Int       @id @default(autoincrement())
  userId                Int       @map("user_id")
  name                  String
  category              String
  description           String?
  purchasePrice         Float?    @map("purchase_price")
  purchaseDate          DateTime? @map("purchase_date")
  currentEstimatedValue Float?    @map("current_estimated_value")
  quantity              Int       @default(1)
  condition             String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user         User           @relation(fields: [userId], references: [id])
  priceHistory PriceHistory[]
  images                InventoryItemImage[]

  @@map("inventory_items")
}

model InventoryItemImage {
  id             Int           @id @default(autoincrement())
  inventoryItemId Int          @map("inventory_item_id")
  userId         Int           @map("user_id")
  imageUrl       String        @map("image_url")
  driveItemId    String        @map("drive_item_id")
  fileName       String        @map("file_name")
  originalName   String?       @map("original_name")
  mimeType       String?       @map("mime_type")
  fileSize       Int?          @map("file_size")
  position       Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  inventoryItem  InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, position])
  @@index([inventoryItemId])
  @@index([userId])
  @@map("inventory_item_images")
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  price     Float
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

model WishlistItem {
  id                     Int       @id @default(autoincrement())
  userId                 Int       @map("user_id")
  name                   String
  category               String
  description            String?
  targetPrice            Float?    @map("target_price")
  currentObservedPrice   Float?    @map("current_observed_price")
  priority               String?
  purchaseUrl            String?   @map("purchase_url")
  store                  String?   @map("store")
  notes                  String?

  isTrackingEnabled      Boolean   @default(true) @map("is_tracking_enabled")
  trackingFrequencyHours Int       @default(24) @map("tracking_frequency_hours")
  currency               String    @default("MXN")

  lastCheckedAt          DateTime? @map("last_checked_at")
  nextCheckAt            DateTime? @map("next_check_at")
  lastPriceChangeAt      DateTime? @map("last_price_change_at")

  consecutiveFailures    Int       @default(0) @map("consecutive_failures")
  lastCheckStatus        String?   @map("last_check_status")
  lastErrorMessage       String?   @map("last_error_message")
  lastAvailability       String?   @map("last_availability")
  lastProviderSource     String?   @map("last_provider_source")

  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  user                   User                   @relation(fields: [userId], references: [id])
  priceHistory           WishlistPriceHistory[]
  alerts                 WishlistAlert[]

  @@index([userId])
  @@index([store])
  @@index([isTrackingEnabled, nextCheckAt])
  @@index([lastCheckedAt])
  @@map("wishlist_items")
}

model WishlistPriceHistory {
  id              Int          @id @default(autoincrement())
  wishlistItemId  Int          @map("wishlist_item_id")
  price           Float
  previousPrice   Float?       @map("previous_price")
  currency        String       @default("MXN")
  source          String?
  detectedAt      DateTime     @default(now()) @map("detected_at")
  createdAt       DateTime     @default(now()) @map("created_at")

  wishlistItem    WishlistItem @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)

  @@index([wishlistItemId])
  @@index([wishlistItemId, detectedAt])
  @@map("wishlist_price_history")
}

model WishlistAlert {
  id                Int          @id @default(autoincrement())
  wishlistItemId    Int          @map("wishlist_item_id")
  userId            Int          @map("user_id")

  type              String
  title             String
  message           String

  status            String       @default("unread")
  priority          String       @default("medium")

  triggeredPrice    Float?       @map("triggered_price")
  previousPrice     Float?       @map("previous_price")
  targetPrice       Float?       @map("target_price")
  percentageChange  Float?       @map("percentage_change")

  metadata          Json?

  triggeredAt       DateTime     @default(now()) @map("triggered_at")
  readAt            DateTime?    @map("read_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  wishlistItem      WishlistItem @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, triggeredAt])
  @@index([wishlistItemId, triggeredAt])
  @@index([type, triggeredAt])
  @@map("wishlist_alerts")
}


